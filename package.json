{
  "name": "vieweditor",
  "productName": "ViewEditor",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first desktop video editor for Windows and macOS",
  "author": "Steve Vaubell",
  "license": "MIT",
  "repository": "github:SteveDeveloperConcepts/ViewEditor",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.mts\"",
    "test:integration": "node --experimental-strip-types --test \"tests/integration/*.test.mts\"",
    "test:e2e": "npm run build && node --experimental-strip-types tests/e2e/run.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "ai:catalog": "node --experimental-strip-types scripts/update-ai-catalog.mts",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac -c build/adhoc-mac.yml",
    "mac:ffmpeg": "node scripts/mac-ffmpeg.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "electron-updater": "^6.8.11",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "playwright-core": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.0.16"
  }
}
